{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "familienplan",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "familienplan",
      "database_id": "5828fddc-8388-4cd9-99f0-9db2464e983e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_MODE": "access",
    // Zero-Trust-Team-Domain (z. B. "<team>.cloudflareaccess.com") und Access-Application-AUD-Tag nach dem Access-Setup eintragen:
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_POLICY_AUD": "",
    // E-Mail des Haushalts-Owners (Bootstrap beim ersten Login)
    "OWNER_EMAIL": ""
  },
  "observability": { "enabled": true }
}
