{
  "name": "familienplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "validate-content": "tsx scripts/validate-content.ts",
    "build": "pnpm --filter @familienplan/web build",
    "verify": "pnpm validate-content && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "pnpm --filter @familienplan/web e2e"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@familienplan/schema": "workspace:*",
    "@familienplan/engine": "workspace:*",
    "@types/node": "^22.0.0"
  }
}
